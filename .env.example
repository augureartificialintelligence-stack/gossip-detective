# Copie este arquivo para .env e preencha a chave. O .env nunca deve ser compartilhado.
ANTHROPIC_API_KEY=

# Opcional e gratuita: chave do Google Cloud com a "Fact Check Tools API" ativada (checagens publicadas por agências)
GOOGLE_FACTCHECK_KEY=

# Opcionais (valores padrão abaixo)
# GD_MODELO=claude-opus-5-5
# GD_ESFORCO=high            # low | medium | high | xhigh | max
# GD_MAX_BUSCAS=15           # buscas na web por investigação
# GD_MAX_LEITURAS=8          # páginas lidas na íntegra por investigação
# GD_MAX_TURNOS=16
# GD_SIMULTANEAS=2           # investigações ao mesmo tempo
# GD_HOST=127.0.0.1          # use 0.0.0.0 para acessar de outros aparelhos da rede
# GD_PORTA=8765
# GD_FALLBACK=1              # modelo de contingência se o classificador de segurança recusar
# GD_TRUSTSTORE=1            # usa os certificados do Windows (antivírus/proxy corporativo)
